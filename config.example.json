{
  "_说明": "复制为 config.json 后修改。所有值均为占位/默认，无环境特定信息。优先级：命令行 > 环境变量 DSH_* > 本文件 > 内置默认。",

  "deploy": {
    "_mode说明": "local=装到本机；ssh=装到 target 指定的主机（局域网/远程通用）",
    "mode": "local",
    "install_node": true,
    "install_ollama": false,
    "start_service": true
  },

  "target": {
    "_说明": "仅 mode=ssh 时需要。局域网填内网 IP/主机名，远程填公网 IP/域名或 SSH 别名",
    "host": "your-host.example.com",
    "user": "your-ssh-user",
    "port": 22,
    "ssh_key": "~/.ssh/id_ed25519",
    "_ssh_options说明": "跳板机示例：-J jump.example.com；留空直接连接",
    "ssh_options": ""
  },

  "dsh": {
    "package": "@deepseek-ai/dsh",
    "_version说明": "latest 或固定版本号（固定更可复现）",
    "version": "latest",
    "port": 3080,
    "bind": "127.0.0.1",
    "profile": "web",
    "config_dir": "~/.dsh",
    "data_dir": ""
  },

  "node": {
    "min_version": "24.9.0",
    "_install_method说明": "nvm | official | system",
    "install_method": "nvm"
  },

  "ollama": {
    "base_url": "http://127.0.0.1:11434",
    "api_key_env": "OLLAMA_API_KEY",
    "models": [],
    "_context说明": "compaction 默认 headroom 65536，contextWindow 需 >=131072 否则切换模型报错",
    "context_window": 131072,
    "max_tokens": 8192
  },

  "service": {
    "_manager说明": "auto | systemd-user | launchd | windows-task | none",
    "manager": "auto",
    "name": "dsh-web",
    "auto_start": true
  }
}
